<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/route_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
    app:cardCornerRadius="28dp" app:cardElevation="6dp" app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/route_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" android:singleLine="true" />
        <TextView android:id="@+id/route_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" android:maxLines="2" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/route_estimate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/route_confirm" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="48dp" android:text="@string/route_confirm" />
            <com.google.android.material.button.MaterialButton android:id="@+id/route_undo" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/route_undo" />
            <com.google.android.material.button.MaterialButton android:id="@+id/route_new" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/route_new" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="@string/route_speed" style="?attr/textInputOutlinedStyle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/route_speed_value" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="numberDecimal" android:singleLine="true" android:selectAllOnFocus="true"
                    android:importantForAutofill="no" android:text="@string/route_default_speed" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="8dp" android:hint="@string/route_pace" style="?attr/textInputOutlinedStyle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/route_pace_value" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" android:selectAllOnFocus="true" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/route_repeat" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="@string/route_repeat" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/route_play" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="48dp" android:text="@string/route_play" />
            <com.google.android.material.button.MaterialButton android:id="@+id/route_stop" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/route_stop" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/route_save" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/route_save_short" />
            <com.google.android.material.button.MaterialButton android:id="@+id/route_select" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/route_select" />
            <com.google.android.material.button.MaterialButton android:id="@+id/route_allocation" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/route_allocation" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

</FrameLayout>